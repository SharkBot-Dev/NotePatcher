{
  "manifest_version": 3,
  "name": "NoteTools",
  "version": "1.1.1",
  "description": "Noteに様々な便利機能を追加します。",
  "permissions": [
    "storage",
    "activeTab",
    "userScripts"
  ],
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": ["https://note.com/*"],
      "js": [
        "content_endload.js"
      ],
      "css": [
        "patch.css"
      ],
      "run_at": "document_end"
    }
  ]
}