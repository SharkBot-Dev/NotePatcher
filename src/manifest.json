{
  "manifest_version": 3,
  "name": "NoteTools",
  "version": "1.0.0",
  "description": "Noteに様々な便利機能を追加します。",
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": ["https://note.com/*"],
      "js": [
        "content_endload.js"
      ],
      "css": [
        "patch.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}